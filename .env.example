# Agents Platform Configuration

# --- RAG Engine ---
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# --- Anthropic API (for RAG chat) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- SSH Dispatch (existing) ---
SSH_TARGET=ubuntu@your-host
SSH_KEY_PATH=/path/to/key
CLAUDE_MODEL=sonnet

# --- Scheduler (existing) ---
ENABLE_SCHEDULER=false
MAX_CONCURRENT_RUNS=2
# Max agents that run in parallel within a single multi-agent run (default 3)
MAX_PARALLEL_PER_RUN=3
# Hard timeout per run, in milliseconds (default 900000 = 15 min)
RUN_TIMEOUT_MS=900000

# --- Discord (existing) ---
DISCORD_WEBHOOK_URL=

# --- App ---
PORT=3001
DATA_DIR=.
# Public base URL the app uses to build links in notifications (default http://localhost:3001)
APP_BASE_URL=http://localhost:3001

# --- Ingestion paths (RAG / knowledge sources) ---
# Root directory the app reads application source from (default /home/ubuntu/apps)
APPS_ROOT=/path/to/apps
# Comma-separated dirs the ingestion endpoint is allowed to read
ALLOWED_INGEST_DIRS=/path/to/apps,/path/to/terraform,/path/to/kube

# --- Demo mode ---
# Set to "true" to run with seeded sample data and disable live dispatch
DEMO_MODE=false
