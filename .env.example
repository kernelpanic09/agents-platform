# Agents Platform configuration. All values are optional for the demo
# (DEMO_MODE=true needs none of them). Live settings can also be changed at
# runtime in the Settings hub, which overrides these env seeds.

# --- App ---
PORT=3001
DATA_DIR=.
# Public base URL used to build links in notifications (default http://localhost:3001)
APP_BASE_URL=http://localhost:3001

# --- Demo mode ---
# "true" seeds rich sample data and fakes live runs; no SSH host or API key needed.
DEMO_MODE=false

# --- Execution backend ---
# subscription = SSH + `claude -p` (no per-token cost) | api = Anthropic API | openai = any OpenAI-compatible endpoint
EXECUTION_BACKEND=subscription
DEFAULT_MAX_TURNS=0          # hard cap on agentic turns per dispatch (0 = unlimited)
STEP_STREAMING=on           # on = stream-json tool-call timelines; off = single JSON blob

# --- SSH dispatch (subscription backend) ---
SSH_TARGET=ubuntu@your-host
SSH_KEY_PATH=/path/to/key
CLAUDE_MODEL=sonnet

# --- Anthropic API (RAG chat, eval judge, task router; and the 'api' exec backend) ---
ANTHROPIC_API_KEY=sk-ant-...
API_MAX_TOKENS=8192

# --- OpenAI-compatible backend (e.g. a local Ollama for $0 aux features) ---
OPENAI_BASE_URL=
OPENAI_API_KEY=none
OPENAI_MODEL=qwen2.5:7b

# --- RAG engine ---
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# --- Scheduler / queue ---
ENABLE_SCHEDULER=false      # gates cron + manual "Run now"
MAX_CONCURRENT_RUNS=2
MAX_PARALLEL_PER_RUN=3      # agents run in parallel within one multi-agent run
RUN_TIMEOUT_MS=900000       # per-dispatch SIGKILL timeout (15 min)
RUN_MAX_RETRIES=0           # auto-retry failed/timed-out runs (0 = none -> dead-letter)

# --- Per-agent provisioning toggles ---
MCP_PROVISIONING=on         # provision declared MCP servers into dispatch
SKILL_PROVISIONING=on       # materialize attached SKILL.md skills into the run workspace
MEMORY_INJECTION=on         # inject episodic memories into the prompt
MEMORY_DISTILLATION=on      # distill durable memories from run output

# --- Retention ---
RETENTION_MAX_RUNS_PER_SCHEDULE=200
RETENTION_MAX_AGE_DAYS=90
METRIC_RETENTION_DAYS=180

# --- Ingestion paths (RAG / knowledge sources) ---
APPS_ROOT=/path/to/apps
ALLOWED_INGEST_DIRS=/path/to/apps,/path/to/terraform

# --- Discord (optional) ---
DISCORD_WEBHOOK_URL=
